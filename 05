import numpy as np

fuel_efficiency = np.array([18, 22, 25, 28, 32])

average_efficiency = np.mean(fuel_efficiency)

percentage_improvement = ((fuel_efficiency[-1] - fuel_efficiency[0]) / fuel_efficiency[0]) * 100

print("Fuel Efficiency of Car Models (mpg):")
print(fuel_efficiency)

print("\nAverage Fuel Efficiency =", average_efficiency, "mpg")

print("Percentage Improvement from First Model to Last Model = {:.2f}%".format(percentage_improvement))
