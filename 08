import pandas as pd

sales_data = pd.DataFrame({
    'Product': ['Laptop','Mouse','Keyboard','Laptop','Mouse',
                'Monitor','Keyboard','Mouse','Printer','Laptop'],
    'Quantity': [5,12,8,7,10,4,6,9,3,11]
})

top_products = sales_data.groupby('Product')['Quantity'].sum() \
                         .sort_values(ascending=False) \
                         .head(5)

print("Top 5 Products Sold")
print(top_products)
